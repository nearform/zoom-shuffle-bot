{
  "name": "zoom-shuffle-bot",
  "version": "3.0.20",
  "description": "",
  "main": "chatbot.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-test-module-mocks --test --env-file=.env.test \"helpers/**/*.test.js\" \"plugins/**/*.test.js\" \"routes/**/*.test.js\"",
    "test:integration": "firebase emulators:exec --only firestore --project shuffle-zoom-bot \"node --experimental-test-module-mocks --test --test-concurrency=1 --env-file=.env.test test/integration/bot.test.js test/integration/healthcheck.test.js test/integration/hook.test.js\"",
    "start": "node chatbot.js",
    "dev": "nodemon chatbot.js",
    "lint": "eslint . --ext .js,.cjs",
    "lint:fix": "eslint --fix . --ext .js,.cjs",
    "db:up": "firebase emulators:start --project shuffle-zoom-bot"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "desm": "^1.3.1",
    "dotenv": "^17.4.2",
    "env-schema": "^7.0.0",
    "fast-json-stringify": "^7.0.1",
    "fastify": "^5.9.0",
    "fastify-plugin": "^6.0.0",
    "fluent-json-schema": "^6.0.0",
    "http-errors": "^2.0.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "firebase-tools": "^14.27.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5"
  }
}
